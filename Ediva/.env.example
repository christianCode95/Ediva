NODE_ENV=development
PORT=8787
EDIVA_DB_PATH=./data/ediva.sqlite

# Na hospedagem Node, permita a origem da própria área do aluno, sem barra no final.
# No Render, a API usa RENDER_EXTERNAL_URL automaticamente quando esta variável não é definida.
# EDIVA_ALLOWED_ORIGINS=https://sua-area-do-aluno.example

# Links públicos da área do aluno podem voltar ao GitHub Pages (valor usado no build).
# VITE_PUBLIC_SITE_URL=https://christiancode95.github.io/Ediva/

# Gabaritos são privados: forneça o arquivo separadamente ou uma variável secreta JSON.
# Não coloque gabaritos nem outros segredos em variáveis VITE_, pois elas vão para o navegador.
# EDIVA_COURSE_ANSWER_KEYS_PATH=./data/course-answer-keys.json

# Ative somente quando estiver atrás de um proxy confiável.
# EDIVA_TRUST_PROXY=true
