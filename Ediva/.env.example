NODE_ENV=development
PORT=8787
EDIVA_DB_PATH=./data/ediva.sqlite

# Em produção, configure a origem pública exata, sem barra no final.
# EDIVA_PUBLIC_URL=https://ediva.com.br
# EDIVA_ALLOWED_ORIGINS=https://ediva.com.br,https://www.ediva.com.br

# Envio de confirmações pelo Gmail oficial (opcional no desenvolvimento; obrigatório em produção).
# Ative a Verificação em duas etapas na conta Google e gere uma senha de app.
# Use a senha de app, não a senha normal do Gmail.
# EDIVA_SMTP_HOST=smtp.gmail.com
# EDIVA_SMTP_PORT=465
# EDIVA_SMTP_SECURE=true
# EDIVA_SMTP_USER=ediva.oficial@gmail.com
# Defina a senha de app somente neste arquivo local ignorado pelo Git ou nos secrets da hospedagem.
# EDIVA_SMTP_PASSWORD=
# EDIVA_MAIL_FROM="EDIVA <ediva.oficial@gmail.com>"
# EDIVA_MAIL_REPLY_TO=ediva.oficial@gmail.com

# Ative somente quando estiver atrás de um proxy confiável.
# EDIVA_TRUST_PROXY=true
